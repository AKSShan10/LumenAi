        <mxCell id="title" value="&lt;b style=&quot;font-size:22px&quot;&gt;LumenAI - LangGraph Workflows (final)&lt;/b&gt;" style="text;strokeColor=none;fillColor=none;html=1;whiteSpace=wrap;fontSize=12;fontColor=#1f2937;align=center;verticalAlign=middle;spacing=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="30" y="18" width="2802" height="34" as="geometry"/></mxCell>
        <mxCell id="sub" value="Seven workflows (app/graphs/*_graph.py) and the Assistant agent: LangGraph is used where a run pauses for a person, loops or runs steps in parallel. The CV claim check (F8) and the interview quality check (F10) are straight lines of steps, so they are plain Python in their services. Every run is logged in workflow_run; paused runs are kept by the PostgreSQL checkpointer." style="text;strokeColor=none;fillColor=none;html=1;whiteSpace=wrap;fontSize=13;fontColor=#4b5563;align=center;verticalAlign=middle;spacing=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="30" y="54" width="2802" height="40" as="geometry"/></mxCell>
