        <mxCell id="start" value="&lt;b style=&quot;font-size:16px&quot;&gt;Start&lt;/b&gt;" style="rounded=1;arcSize=50;fillColor=#2F2F2F;strokeColor=none;html=1;whiteSpace=wrap;fontSize=12;fontColor=#FFFFFF;align=center;verticalAlign=middle;spacing=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="198.0" y="160" width="120" height="46" as="geometry"/></mxCell>
        <mxCell id="end" value="&lt;b style=&quot;font-size:16px&quot;&gt;End&lt;/b&gt;" style="rounded=1;arcSize=50;fillColor=#2F2F2F;strokeColor=none;html=1;whiteSpace=wrap;fontSize=12;fontColor=#FFFFFF;align=center;verticalAlign=middle;spacing=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1656.0" y="160" width="120" height="46" as="geometry"/></mxCell>
        <mxCell id="note1" value="&lt;b style=&quot;font-size:11px&quot;&gt;Dashboard and log&lt;/b&gt;&lt;br&gt;The Dashboard counts every job, CV, interview and report (code, no AI). One log file: every API call and every AI call with its tokens (input, output, thinking), in Bangladesh time." style="rounded=1;arcSize=12;fillColor=#FFFFFF;strokeColor=#BBBBBB;dashed=1;strokeWidth=1.3;html=1;whiteSpace=wrap;fontSize=11;fontColor=#444444;align=left;verticalAlign=middle;spacing=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="526" y="144" width="420" height="84" as="geometry"/></mxCell>
        <mxCell id="note2" value="&lt;b style=&quot;font-size:11px&quot;&gt;People decide&lt;/b&gt;&lt;br&gt;The AI only suggests. A person approves and posts the job, sends emails, shortlists and decides. Candidates never see scores, notes or the helper. Every AI quote is checked against the CV or the transcript." style="rounded=1;arcSize=12;fillColor=#FFFFFF;strokeColor=#BBBBBB;dashed=1;strokeWidth=1.3;html=1;whiteSpace=wrap;fontSize=11;fontColor=#444444;align=left;verticalAlign=middle;spacing=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1012" y="144" width="420" height="84" as="geometry"/></mxCell>
        <mxCell id="plat_t" value="&lt;b style=&quot;font-size:13px&quot;&gt;Platform&lt;/b&gt;&lt;br&gt;used by every step" style="text;strokeColor=none;fillColor=none;html=1;whiteSpace=wrap;fontSize=11;fontColor=#1A1A1A;align=left;verticalAlign=middle;spacing=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="20" y="940" width="150" height="60" as="geometry"/></mxCell>
        <mxCell id="plat0" value="&lt;b style=&quot;font-size:12px&quot;&gt;Login&lt;/b&gt;&lt;br&gt;JWT for interviewers; candidates use a private link" style="rounded=1;arcSize=12;fillColor=#F7F7F7;strokeColor=#999999;strokeWidth=1.3;html=1;whiteSpace=wrap;fontSize=11;fontColor=#1A1A1A;align=center;verticalAlign=middle;spacing=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="190.0" y="940" width="338.4" height="60" as="geometry"/></mxCell>
