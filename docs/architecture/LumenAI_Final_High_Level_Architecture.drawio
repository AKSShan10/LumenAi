        <mxCell id="lglhr" value="Interviewer / HR" style="text;strokeColor=none;fillColor=none;html=1;whiteSpace=wrap;fontSize=12;fontColor=#1f2937;align=left;verticalAlign=middle;spacing=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="72" y="787" width="230" height="24" as="geometry"/></mxCell>
        <mxCell id="lgsys" value="" style="rounded=1;arcSize=12;fillColor=#F5A623;strokeColor=none;html=1;whiteSpace=wrap;fontSize=12;fontColor=#1f2937;align=center;verticalAlign=middle;spacing=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="314" y="790" width="22" height="18" as="geometry"/></mxCell>
        <mxCell id="lglsys" value="System (automatic, incl. AI)" style="text;strokeColor=none;fillColor=none;html=1;whiteSpace=wrap;fontSize=12;fontColor=#1f2937;align=left;verticalAlign=middle;spacing=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="342" y="787" width="230" height="24" as="geometry"/></mxCell>
        <mxCell id="lgcand" value="" style="rounded=1;arcSize=12;fillColor=#2E6DB4;strokeColor=none;html=1;whiteSpace=wrap;fontSize=12;fontColor=#1f2937;align=center;verticalAlign=middle;spacing=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="44" y="818" width="22" height="18" as="geometry"/></mxCell>
        <mxCell id="lglcand" value="Candidate" style="text;strokeColor=none;fillColor=none;html=1;whiteSpace=wrap;fontSize=12;fontColor=#1f2937;align=left;verticalAlign=middle;spacing=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="72" y="815" width="230" height="24" as="geometry"/></mxCell>
        <mxCell id="lgboth" value="" style="rounded=1;arcSize=12;fillColor=#6C4FB0;strokeColor=none;html=1;whiteSpace=wrap;fontSize=12;fontColor=#1f2937;align=center;verticalAlign=middle;spacing=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="314" y="818" width="22" height="18" as="geometry"/></mxCell>
        <mxCell id="lglboth" value="Interviewer + candidate" style="text;strokeColor=none;fillColor=none;html=1;whiteSpace=wrap;fontSize=12;fontColor=#1f2937;align=left;verticalAlign=middle;spacing=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="342" y="815" width="230" height="24" as="geometry"/></mxCell>
        <mxCell id="rule" value="&lt;b style=&quot;font-size:12px&quot;&gt;People decide, the AI helps&lt;/b&gt;&lt;br&gt;The AI never approves a job, posts it, sends an email, includes or excludes a candidate or hires. It drafts, scores and explains; a person clicks or answers Yes. Scores and the helper are never shown to the candidate." style="rounded=1;arcSize=2;fillColor=#FFFFFF;strokeColor=#999999;dashed=1;strokeWidth=1.3;html=1;whiteSpace=wrap;fontSize=12;fontColor=#1f2937;align=left;verticalAlign=middle;spacing=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="620" y="754" width="470" height="96" as="geometry"/></mxCell>
        <mxCell id="dash" value="&lt;b style=&quot;font-size:12px&quot;&gt;Dashboard and log&lt;/b&gt;&lt;br&gt;The Dashboard counts jobs, CVs, interviews and reports (code, no AI). One log file shows every API and AI call with its tokens, in Bangladesh time." style="rounded=1;arcSize=2;fillColor=#FFFFFF;strokeColor=#999999;dashed=1;strokeWidth=1.3;html=1;whiteSpace=wrap;fontSize=12;fontColor=#1f2937;align=left;verticalAlign=middle;spacing=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1120" y="754" width="320" height="96" as="geometry"/></mxCell>
