  <diagram name="LumenAI High-Level Architecture" id="17596159">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1470" pageHeight="880" background="#FFFFFF" adaptiveColors="none" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
