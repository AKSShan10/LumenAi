<mxfile host="LumenAI">
  <diagram name="LumenAI Final High-Level Architecture" id="958525">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1470" pageHeight="788" background="#FFFFFF" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" value="&lt;b style=&quot;font-size:22px&quot;&gt;LumenAI - High-Level Architecture (final)&lt;/b&gt;" style="text;strokeColor=none;fillColor=none;html=1;whiteSpace=wrap;fontSize=12;fontColor=#1f2937;align=center;verticalAlign=middle;spacing=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="30" y="20" width="1410" height="34" as="geometry"/></mxCell>
        <mxCell id="sub" value="From the job description to the hiring decision: 16 steps in 4 phases. Read column 1 down, column 2 up, column 3 down, column 4 up." style="text;strokeColor=none;fillColor=none;html=1;whiteSpace=wrap;fontSize=13;fontColor=#4b5563;align=center;verticalAlign=middle;spacing=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="30" y="56" width="1410" height="30" as="geometry"/></mxCell>
        <mxCell id="lane0" value="" style="rounded=1;arcSize=2;fillColor=#f8fafc;strokeColor=#cbd5e1;strokeWidth=1.3;html=1;whiteSpace=wrap;fontSize=12;fontColor=#1f2937;align=center;verticalAlign=middle;spacing=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="18" y="110" width="324" height="528" as="geometry"/></mxCell>
        <mxCell id="ph0" value="&lt;b style=&quot;font-size:16px&quot;&gt;1. Prepare the job&lt;/b&gt;" style="text;strokeColor=none;fillColor=none;html=1;whiteSpace=wrap;fontSize=12;fontColor=#1f2937;align=center;verticalAlign=middle;spacing=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="30" y="120" width="300" height="36" as="geometry"/></mxCell>
        <mxCell id="s1" value="&lt;b style=&quot;font-size:12px&quot;&gt;Step 1&lt;/b&gt;&lt;br&gt;HR describes the job in the Assistant chat (Jobs page)" style="rounded=1;arcSize=12;fillColor=#dbeafe;strokeColor=#2563eb;strokeWidth=1.3;html=1;whiteSpace=wrap;fontSize=12;fontColor=#1f2937;align=center;verticalAlign=middle;spacing=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="30" y="166" width="300" height="84" as="geometry"/></mxCell>
        <mxCell id="s2" value="&lt;b style=&quot;font-size:12px&quot;&gt;Step 2&lt;/b&gt;&lt;br&gt;AI writes the job description from the Knowledge base (RAG)" style="rounded=1;arcSize=12;fillColor=#ede9fe;strokeColor=#7c3aed;strokeWidth=1.3;html=1;whiteSpace=wrap;fontSize=12;fontColor=#1f2937;align=center;verticalAlign=middle;spacing=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="30" y="286" width="300" height="84" as="geometry"/></mxCell>
        <mxCell id="s3" value="&lt;b style=&quot;font-size:12px&quot;&gt;Step 3&lt;/b&gt;&lt;br&gt;HR reviews the draft and answers Yes to approve" style="rounded=1;arcSize=12;fillColor=#dbeafe;strokeColor=#2563eb;strokeWidth=1.3;html=1;whiteSpace=wrap;fontSize=12;fontColor=#1f2937;align=center;verticalAlign=middle;spacing=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="30" y="406" width="300" height="84" as="geometry"/></mxCell>
        <mxCell id="s4" value="&lt;b style=&quot;font-size:12px&quot;&gt;Step 4&lt;/b&gt;&lt;br&gt;System posts the job to Blogger with the Google Form link (only after the Yes)" style="rounded=1;arcSize=12;fillColor=#dcfce7;strokeColor=#16a34a;strokeWidth=1.3;html=1;whiteSpace=wrap;fontSize=12;fontColor=#1f2937;align=center;verticalAlign=middle;spacing=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="30" y="526" width="300" height="84" as="geometry"/></mxCell>
        <mxCell id="lane1" value="" style="rounded=1;arcSize=2;fillColor=#f8fafc;strokeColor=#cbd5e1;strokeWidth=1.3;html=1;whiteSpace=wrap;fontSize=12;fontColor=#1f2937;align=center;verticalAlign=middle;spacing=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="388" y="110" width="324" height="528" as="geometry"/></mxCell>
        <mxCell id="ph1" value="&lt;b style=&quot;font-size:16px&quot;&gt;2. Find the best CVs&lt;/b&gt;" style="text;strokeColor=none;fillColor=none;html=1;whiteSpace=wrap;fontSize=12;fontColor=#1f2937;align=center;verticalAlign=middle;spacing=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="400" y="120" width="300" height="36" as="geometry"/></mxCell>
        <mxCell id="s8" value="&lt;b style=&quot;font-size:12px&quot;&gt;Step 8&lt;/b&gt;&lt;br&gt;HR reviews, includes or excludes, sets the weights and shortlists" style="rounded=1;arcSize=12;fillColor=#dbeafe;strokeColor=#2563eb;strokeWidth=1.3;html=1;whiteSpace=wrap;fontSize=12;fontColor=#1f2937;align=center;verticalAlign=middle;spacing=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="400" y="166" width="300" height="84" as="geometry"/></mxCell>
        <mxCell id="s7" value="&lt;b style=&quot;font-size:12px&quot;&gt;Step 7&lt;/b&gt;&lt;br&gt;AI reads every CV: met / partial / unmet + section scores; code decides passed / excluded / needs review" style="rounded=1;arcSize=12;fillColor=#ede9fe;strokeColor=#7c3aed;strokeWidth=1.3;html=1;whiteSpace=wrap;fontSize=12;fontColor=#1f2937;align=center;verticalAlign=middle;spacing=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="400" y="286" width="300" height="84" as="geometry"/></mxCell>
        <mxCell id="s6" value="&lt;b style=&quot;font-size:12px&quot;&gt;Step 6&lt;/b&gt;&lt;br&gt;System fetches new applications (or HR uploads a CV); the photo becomes a face vector" style="rounded=1;arcSize=12;fillColor=#dcfce7;strokeColor=#16a34a;strokeWidth=1.3;html=1;whiteSpace=wrap;fontSize=12;fontColor=#1f2937;align=center;verticalAlign=middle;spacing=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="400" y="406" width="300" height="84" as="geometry"/></mxCell>
        <mxCell id="s5" value="&lt;b style=&quot;font-size:12px&quot;&gt;Step 5&lt;/b&gt;&lt;br&gt;Candidate applies through the Google Form (CV, photo, contact)" style="rounded=1;arcSize=12;fillColor=#ffedd5;strokeColor=#ea580c;strokeWidth=1.3;html=1;whiteSpace=wrap;fontSize=12;fontColor=#1f2937;align=center;verticalAlign=middle;spacing=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="400" y="526" width="300" height="84" as="geometry"/></mxCell>
        <mxCell id="lane2" value="" style="rounded=1;arcSize=2;fillColor=#f8fafc;strokeColor=#cbd5e1;strokeWidth=1.3;html=1;whiteSpace=wrap;fontSize=12;fontColor=#1f2937;align=center;verticalAlign=middle;spacing=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="758" y="110" width="324" height="528" as="geometry"/></mxCell>
        <mxCell id="ph2" value="&lt;b style=&quot;font-size:16px&quot;&gt;3. Hold the interview&lt;/b&gt;" style="text;strokeColor=none;fillColor=none;html=1;whiteSpace=wrap;fontSize=12;fontColor=#1f2937;align=center;verticalAlign=middle;spacing=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="770" y="120" width="300" height="36" as="geometry"/></mxCell>
        <mxCell id="s9" value="&lt;b style=&quot;font-size:12px&quot;&gt;Step 9&lt;/b&gt;&lt;br&gt;HR schedules the interviews" style="rounded=1;arcSize=12;fillColor=#dbeafe;strokeColor=#2563eb;strokeWidth=1.3;html=1;whiteSpace=wrap;fontSize=12;fontColor=#1f2937;align=center;verticalAlign=middle;spacing=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="770" y="166" width="300" height="84" as="geometry"/></mxCell>
        <mxCell id="s10" value="&lt;b style=&quot;font-size:12px&quot;&gt;Step 10&lt;/b&gt;&lt;br&gt;AI drafts the invitation; HR checks and sends it (link + calendar)" style="rounded=1;arcSize=12;fillColor=#ede9fe;strokeColor=#7c3aed;strokeWidth=1.3;html=1;whiteSpace=wrap;fontSize=12;fontColor=#1f2937;align=center;verticalAlign=middle;spacing=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="770" y="286" width="300" height="84" as="geometry"/></mxCell>
        <mxCell id="s11" value="&lt;b style=&quot;font-size:12px&quot;&gt;Step 11&lt;/b&gt;&lt;br&gt;HR and candidate join the video call (LiveKit); identity check of the face (F7)" style="rounded=1;arcSize=12;fillColor=#dbeafe;strokeColor=#2563eb;strokeWidth=1.3;html=1;whiteSpace=wrap;fontSize=12;fontColor=#1f2937;align=center;verticalAlign=middle;spacing=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="770" y="406" width="300" height="84" as="geometry"/></mxCell>
        <mxCell id="s12" value="&lt;b style=&quot;font-size:12px&quot;&gt;Step 12&lt;/b&gt;&lt;br&gt;Live transcript (Deepgram) and AI Helper, seen by the interviewer only" style="rounded=1;arcSize=12;fillColor=#ede9fe;strokeColor=#7c3aed;strokeWidth=1.3;html=1;whiteSpace=wrap;fontSize=12;fontColor=#1f2937;align=center;verticalAlign=middle;spacing=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="770" y="526" width="300" height="84" as="geometry"/></mxCell>
        <mxCell id="lane3" value="" style="rounded=1;arcSize=2;fillColor=#f8fafc;strokeColor=#cbd5e1;strokeWidth=1.3;html=1;whiteSpace=wrap;fontSize=12;fontColor=#1f2937;align=center;verticalAlign=middle;spacing=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1128" y="110" width="324" height="528" as="geometry"/></mxCell>
        <mxCell id="ph3" value="&lt;b style=&quot;font-size:16px&quot;&gt;4. Assess and decide&lt;/b&gt;" style="text;strokeColor=none;fillColor=none;html=1;whiteSpace=wrap;fontSize=12;fontColor=#1f2937;align=center;verticalAlign=middle;spacing=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1140" y="120" width="300" height="36" as="geometry"/></mxCell>
        <mxCell id="s16" value="&lt;b style=&quot;font-size:12px&quot;&gt;Step 16&lt;/b&gt;&lt;br&gt;Good candidates go to the Talent Pool for later jobs (F11)" style="rounded=1;arcSize=12;fillColor=#dcfce7;strokeColor=#16a34a;strokeWidth=1.3;html=1;whiteSpace=wrap;fontSize=12;fontColor=#1f2937;align=center;verticalAlign=middle;spacing=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1140" y="166" width="300" height="84" as="geometry"/></mxCell>
        <mxCell id="s15" value="&lt;b style=&quot;font-size:12px&quot;&gt;Step 15&lt;/b&gt;&lt;br&gt;HR compares the candidates and decides: hire, hold or reject" style="rounded=1;arcSize=12;fillColor=#dbeafe;strokeColor=#2563eb;strokeWidth=1.3;html=1;whiteSpace=wrap;fontSize=12;fontColor=#1f2937;align=center;verticalAlign=middle;spacing=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1140" y="286" width="300" height="84" as="geometry"/></mxCell>
        <mxCell id="s14" value="&lt;b style=&quot;font-size:12px&quot;&gt;Step 14&lt;/b&gt;&lt;br&gt;Assessment report + CV claim check against the interview (F8)" style="rounded=1;arcSize=12;fillColor=#ede9fe;strokeColor=#7c3aed;strokeWidth=1.3;html=1;whiteSpace=wrap;fontSize=12;fontColor=#1f2937;align=center;verticalAlign=middle;spacing=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1140" y="406" width="300" height="84" as="geometry"/></mxCell>
        <mxCell id="s13" value="&lt;b style=&quot;font-size:12px&quot;&gt;Step 13&lt;/b&gt;&lt;br&gt;Six graders score each answer: scorecard (F9); interview quality check (F10)" style="rounded=1;arcSize=12;fillColor=#ede9fe;strokeColor=#7c3aed;strokeWidth=1.3;html=1;whiteSpace=wrap;fontSize=12;fontColor=#1f2937;align=center;verticalAlign=middle;spacing=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1140" y="526" width="300" height="84" as="geometry"/></mxCell>
        <mxCell id="legend" value="" style="rounded=1;arcSize=2;fillColor=#ffffff;strokeColor=#cbd5e1;strokeWidth=1.3;html=1;whiteSpace=wrap;fontSize=12;fontColor=#1f2937;align=center;verticalAlign=middle;spacing=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="30" y="662" width="560" height="96" as="geometry"/></mxCell>
        <mxCell id="lgt" value="&lt;b style=&quot;font-size:13px&quot;&gt;Who does the step&lt;/b&gt;" style="text;strokeColor=none;fillColor=none;html=1;whiteSpace=wrap;fontSize=12;fontColor=#1f2937;align=left;verticalAlign=middle;spacing=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="668" width="200" height="22" as="geometry"/></mxCell>
        <mxCell id="lghr" value="" style="rounded=1;arcSize=12;fillColor=#dbeafe;strokeColor=#2563eb;strokeWidth=1.3;html=1;whiteSpace=wrap;fontSize=12;fontColor=#1f2937;align=center;verticalAlign=middle;spacing=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="44" y="698" width="22" height="18" as="geometry"/></mxCell>
        <mxCell id="lglhr" value="HR / interviewer" style="text;strokeColor=none;fillColor=none;html=1;whiteSpace=wrap;fontSize=12;fontColor=#1f2937;align=left;verticalAlign=middle;spacing=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="72" y="695" width="230" height="24" as="geometry"/></mxCell>
        <mxCell id="lgai" value="" style="rounded=1;arcSize=12;fillColor=#ede9fe;strokeColor=#7c3aed;strokeWidth=1.3;html=1;whiteSpace=wrap;fontSize=12;fontColor=#1f2937;align=center;verticalAlign=middle;spacing=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="314" y="698" width="22" height="18" as="geometry"/></mxCell>
        <mxCell id="lglai" value="AI (LangGraph + Gemini)" style="text;strokeColor=none;fillColor=none;html=1;whiteSpace=wrap;fontSize=12;fontColor=#1f2937;align=left;verticalAlign=middle;spacing=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="342" y="695" width="230" height="24" as="geometry"/></mxCell>
        <mxCell id="lgsys" value="" style="rounded=1;arcSize=12;fillColor=#dcfce7;strokeColor=#16a34a;strokeWidth=1.3;html=1;whiteSpace=wrap;fontSize=12;fontColor=#1f2937;align=center;verticalAlign=middle;spacing=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="44" y="726" width="22" height="18" as="geometry"/></mxCell>
        <mxCell id="lglsys" value="System (backend code)" style="text;strokeColor=none;fillColor=none;html=1;whiteSpace=wrap;fontSize=12;fontColor=#1f2937;align=left;verticalAlign=middle;spacing=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="72" y="723" width="230" height="24" as="geometry"/></mxCell>
        <mxCell id="lgcand" value="" style="rounded=1;arcSize=12;fillColor=#ffedd5;strokeColor=#ea580c;strokeWidth=1.3;html=1;whiteSpace=wrap;fontSize=12;fontColor=#1f2937;align=center;verticalAlign=middle;spacing=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="314" y="726" width="22" height="18" as="geometry"/></mxCell>
        <mxCell id="lglcand" value="Candidate" style="text;strokeColor=none;fillColor=none;html=1;whiteSpace=wrap;fontSize=12;fontColor=#1f2937;align=left;verticalAlign=middle;spacing=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="342" y="723" width="230" height="24" as="geometry"/></mxCell>
        <mxCell id="rule" value="&lt;b style=&quot;font-size:12px&quot;&gt;People decide, the AI helps&lt;/b&gt;&lt;br&gt;The AI never approves a job, posts it, sends an email, includes or excludes a candidate or hires. It drafts, scores and explains; a person clicks or answers Yes. Scores and the helper are never shown to the candidate." style="rounded=1;arcSize=2;fillColor=#fef9c3;strokeColor=#ca8a04;strokeWidth=1.3;html=1;whiteSpace=wrap;fontSize=12;fontColor=#1f2937;align=left;verticalAlign=middle;spacing=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="620" y="662" width="470" height="96" as="geometry"/></mxCell>
        <mxCell id="dash" value="&lt;b style=&quot;font-size:12px&quot;&gt;Dashboard and log&lt;/b&gt;&lt;br&gt;The Dashboard counts jobs, CVs, interviews and reports (code, no AI). One log file shows every API and AI call with its tokens, in Bangladesh time." style="rounded=1;arcSize=2;fillColor=#f1f5f9;strokeColor=#64748b;strokeWidth=1.3;html=1;whiteSpace=wrap;fontSize=12;fontColor=#1f2937;align=left;verticalAlign=middle;spacing=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1120" y="662" width="320" height="96" as="geometry"/></mxCell>
        <mxCell id="e0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#4b5563;fontSize=11;fontColor=#4b5563;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="s1" target="s2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#4b5563;fontSize=11;fontColor=#4b5563;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="s2" target="s3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#4b5563;fontSize=11;fontColor=#4b5563;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="s3" target="s4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#4b5563;fontSize=11;fontColor=#4b5563;labelBackgroundColor=#ffffff;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="s5" target="s6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
