        <mxCell id="title" value="&lt;b style=&quot;font-size:22px&quot;&gt;LumenAI - High-Level Architecture&lt;/b&gt;" style="text;strokeColor=none;fillColor=none;html=1;whiteSpace=wrap;fontSize=12;fontColor=#1f2937;align=center;verticalAlign=middle;spacing=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="30" y="20" width="1410" height="34" as="geometry"/></mxCell>
        <mxCell id="sub" value="From the job description to the hiring decision: 16 steps in 4 phases. Read column 1 down, column 2 up, column 3 down, column 4 up." style="text;strokeColor=none;fillColor=none;html=1;whiteSpace=wrap;fontSize=13;fontColor=#4b5563;align=center;verticalAlign=middle;spacing=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="30" y="56" width="1410" height="30" as="geometry"/></mxCell>
        <mxCell id="lane0" value="" style="rounded=1;arcSize=2;fillColor=#E8F4F1;strokeColor=none;html=1;whiteSpace=wrap;fontSize=12;fontColor=#1f2937;align=center;verticalAlign=middle;spacing=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="18" y="110" width="324" height="620" as="geometry"/></mxCell>
        <mxCell id="ph0" value="&lt;b style=&quot;font-size:16px&quot;&gt;1. Prepare the job&lt;/b&gt;" style="text;strokeColor=none;fillColor=none;html=1;whiteSpace=wrap;fontSize=12;fontColor=#1A1A1A;align=center;verticalAlign=middle;spacing=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="30" y="120" width="300" height="36" as="geometry"/></mxCell>
        <mxCell id="s1" value="&lt;b style=&quot;font-size:10px&quot;&gt;INTERVIEWER / HR&lt;/b&gt;&lt;br&gt;HR describes the job in the Assistant chat (Jobs page)" style="rounded=1;arcSize=12;fillColor=#148F77;strokeColor=none;html=1;whiteSpace=wrap;fontSize=12;fontColor=#FFFFFF;align=center;verticalAlign=middle;spacing=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="30" y="232" width="300" height="92" as="geometry"/></mxCell>
        <mxCell id="b1" value="&lt;b style=&quot;font-size:12px&quot;&gt;1&lt;/b&gt;" style="shape=ellipse;perimeter=ellipsePerimeter;fillColor=#FFFFFF;strokeColor=#148F77;strokeWidth=2;html=1;whiteSpace=wrap;fontSize=12;fontColor=#1A1A1A;align=center;verticalAlign=middle;spacing=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="18" y="220" width="28" height="28" as="geometry"/></mxCell>
        <mxCell id="s2" value="&lt;b style=&quot;font-size:10px&quot;&gt;SYSTEM&lt;/b&gt;&lt;br&gt;AI writes the job description from the Knowledge base (RAG)" style="rounded=1;arcSize=12;fillColor=#F5A623;strokeColor=none;html=1;whiteSpace=wrap;fontSize=12;fontColor=#1A1A1A;align=center;verticalAlign=middle;spacing=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="30" y="358" width="300" height="92" as="geometry"/></mxCell>
        <mxCell id="b2" value="&lt;b style=&quot;font-size:12px&quot;&gt;2&lt;/b&gt;" style="shape=ellipse;perimeter=ellipsePerimeter;fillColor=#FFFFFF;strokeColor=#F5A623;strokeWidth=2;html=1;whiteSpace=wrap;fontSize=12;fontColor=#1A1A1A;align=center;verticalAlign=middle;spacing=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="18" y="346" width="28" height="28" as="geometry"/></mxCell>
        <mxCell id="s3" value="&lt;b style=&quot;font-size:10px&quot;&gt;INTERVIEWER / HR&lt;/b&gt;&lt;br&gt;HR reviews the draft and answers Yes to approve" style="rounded=1;arcSize=12;fillColor=#148F77;strokeColor=none;html=1;whiteSpace=wrap;fontSize=12;fontColor=#FFFFFF;align=center;verticalAlign=middle;spacing=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="30" y="484" width="300" height="92" as="geometry"/></mxCell>
        <mxCell id="b3" value="&lt;b style=&quot;font-size:12px&quot;&gt;3&lt;/b&gt;" style="shape=ellipse;perimeter=ellipsePerimeter;fillColor=#FFFFFF;strokeColor=#148F77;strokeWidth=2;html=1;whiteSpace=wrap;fontSize=12;fontColor=#1A1A1A;align=center;verticalAlign=middle;spacing=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="18" y="472" width="28" height="28" as="geometry"/></mxCell>
        <mxCell id="s4" value="&lt;b style=&quot;font-size:10px&quot;&gt;INTERVIEWER / HR&lt;/b&gt;&lt;br&gt;The job is posted to Blogger with the Google Form link, only after HR&amp;#x27;s Yes" style="rounded=1;arcSize=12;fillColor=#148F77;strokeColor=none;html=1;whiteSpace=wrap;fontSize=12;fontColor=#FFFFFF;align=center;verticalAlign=middle;spacing=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="30" y="610" width="300" height="92" as="geometry"/></mxCell>
        <mxCell id="b4" value="&lt;b style=&quot;font-size:12px&quot;&gt;4&lt;/b&gt;" style="shape=ellipse;perimeter=ellipsePerimeter;fillColor=#FFFFFF;strokeColor=#148F77;strokeWidth=2;html=1;whiteSpace=wrap;fontSize=12;fontColor=#1A1A1A;align=center;verticalAlign=middle;spacing=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="18" y="598" width="28" height="28" as="geometry"/></mxCell>
        <mxCell id="lane1" value="" style="rounded=1;arcSize=2;fillColor=#FDF5E6;strokeColor=none;html=1;whiteSpace=wrap;fontSize=12;fontColor=#1f2937;align=center;verticalAlign=middle;spacing=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="388" y="110" width="324" height="620" as="geometry"/></mxCell>
        <mxCell id="ph1" value="&lt;b style=&quot;font-size:16px&quot;&gt;2. Find the best CVs&lt;/b&gt;" style="text;strokeColor=none;fillColor=none;html=1;whiteSpace=wrap;fontSize=12;fontColor=#1A1A1A;align=center;verticalAlign=middle;spacing=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="400" y="120" width="300" height="36" as="geometry"/></mxCell>
        <mxCell id="s8" value="&lt;b style=&quot;font-size:10px&quot;&gt;INTERVIEWER / HR&lt;/b&gt;&lt;br&gt;HR reviews, includes or excludes, sets the weights and shortlists" style="rounded=1;arcSize=12;fillColor=#148F77;strokeColor=none;html=1;whiteSpace=wrap;fontSize=12;fontColor=#FFFFFF;align=center;verticalAlign=middle;spacing=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="400" y="232" width="300" height="92" as="geometry"/></mxCell>
        <mxCell id="b8" value="&lt;b style=&quot;font-size:12px&quot;&gt;8&lt;/b&gt;" style="shape=ellipse;perimeter=ellipsePerimeter;fillColor=#FFFFFF;strokeColor=#148F77;strokeWidth=2;html=1;whiteSpace=wrap;fontSize=12;fontColor=#1A1A1A;align=center;verticalAlign=middle;spacing=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="388" y="220" width="28" height="28" as="geometry"/></mxCell>
        <mxCell id="s7" value="&lt;b style=&quot;font-size:10px&quot;&gt;SYSTEM&lt;/b&gt;&lt;br&gt;AI reads every CV: met / partial / unmet + section scores; code decides passed / excluded / needs review" style="rounded=1;arcSize=12;fillColor=#F5A623;strokeColor=none;html=1;whiteSpace=wrap;fontSize=12;fontColor=#1A1A1A;align=center;verticalAlign=middle;spacing=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="400" y="358" width="300" height="92" as="geometry"/></mxCell>
        <mxCell id="b7" value="&lt;b style=&quot;font-size:12px&quot;&gt;7&lt;/b&gt;" style="shape=ellipse;perimeter=ellipsePerimeter;fillColor=#FFFFFF;strokeColor=#F5A623;strokeWidth=2;html=1;whiteSpace=wrap;fontSize=12;fontColor=#1A1A1A;align=center;verticalAlign=middle;spacing=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="388" y="346" width="28" height="28" as="geometry"/></mxCell>
        <mxCell id="s6" value="&lt;b style=&quot;font-size:10px&quot;&gt;INTERVIEWER / HR&lt;/b&gt;&lt;br&gt;HR fetches new applications (or uploads a CV); the photo becomes a face vector" style="rounded=1;arcSize=12;fillColor=#148F77;strokeColor=none;html=1;whiteSpace=wrap;fontSize=12;fontColor=#FFFFFF;align=center;verticalAlign=middle;spacing=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="400" y="484" width="300" height="92" as="geometry"/></mxCell>
        <mxCell id="b6" value="&lt;b style=&quot;font-size:12px&quot;&gt;6&lt;/b&gt;" style="shape=ellipse;perimeter=ellipsePerimeter;fillColor=#FFFFFF;strokeColor=#148F77;strokeWidth=2;html=1;whiteSpace=wrap;fontSize=12;fontColor=#1A1A1A;align=center;verticalAlign=middle;spacing=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="388" y="472" width="28" height="28" as="geometry"/></mxCell>
        <mxCell id="s5" value="&lt;b style=&quot;font-size:10px&quot;&gt;CANDIDATE&lt;/b&gt;&lt;br&gt;Candidate applies through the Google Form (CV, photo, contact)" style="rounded=1;arcSize=12;fillColor=#2E6DB4;strokeColor=none;html=1;whiteSpace=wrap;fontSize=12;fontColor=#FFFFFF;align=center;verticalAlign=middle;spacing=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="400" y="610" width="300" height="92" as="geometry"/></mxCell>
        <mxCell id="b5" value="&lt;b style=&quot;font-size:12px&quot;&gt;5&lt;/b&gt;" style="shape=ellipse;perimeter=ellipsePerimeter;fillColor=#FFFFFF;strokeColor=#2E6DB4;strokeWidth=2;html=1;whiteSpace=wrap;fontSize=12;fontColor=#1A1A1A;align=center;verticalAlign=middle;spacing=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="388" y="598" width="28" height="28" as="geometry"/></mxCell>
        <mxCell id="lane2" value="" style="rounded=1;arcSize=2;fillColor=#EAF1FB;strokeColor=none;html=1;whiteSpace=wrap;fontSize=12;fontColor=#1f2937;align=center;verticalAlign=middle;spacing=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="758" y="110" width="324" height="620" as="geometry"/></mxCell>
        <mxCell id="ph2" value="&lt;b style=&quot;font-size:16px&quot;&gt;3. Hold the interview&lt;/b&gt;" style="text;strokeColor=none;fillColor=none;html=1;whiteSpace=wrap;fontSize=12;fontColor=#1A1A1A;align=center;verticalAlign=middle;spacing=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="770" y="120" width="300" height="36" as="geometry"/></mxCell>
        <mxCell id="s9" value="&lt;b style=&quot;font-size:10px&quot;&gt;INTERVIEWER / HR&lt;/b&gt;&lt;br&gt;HR schedules the interviews" style="rounded=1;arcSize=12;fillColor=#148F77;strokeColor=none;html=1;whiteSpace=wrap;fontSize=12;fontColor=#FFFFFF;align=center;verticalAlign=middle;spacing=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="770" y="232" width="300" height="92" as="geometry"/></mxCell>
        <mxCell id="b9" value="&lt;b style=&quot;font-size:12px&quot;&gt;9&lt;/b&gt;" style="shape=ellipse;perimeter=ellipsePerimeter;fillColor=#FFFFFF;strokeColor=#148F77;strokeWidth=2;html=1;whiteSpace=wrap;fontSize=12;fontColor=#1A1A1A;align=center;verticalAlign=middle;spacing=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="758" y="220" width="28" height="28" as="geometry"/></mxCell>
        <mxCell id="s10" value="&lt;b style=&quot;font-size:10px&quot;&gt;SYSTEM&lt;/b&gt;&lt;br&gt;AI drafts the invitation; HR checks and sends it (link + calendar)" style="rounded=1;arcSize=12;fillColor=#F5A623;strokeColor=none;html=1;whiteSpace=wrap;fontSize=12;fontColor=#1A1A1A;align=center;verticalAlign=middle;spacing=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="770" y="358" width="300" height="92" as="geometry"/></mxCell>
        <mxCell id="b10" value="&lt;b style=&quot;font-size:12px&quot;&gt;10&lt;/b&gt;" style="shape=ellipse;perimeter=ellipsePerimeter;fillColor=#FFFFFF;strokeColor=#F5A623;strokeWidth=2;html=1;whiteSpace=wrap;fontSize=12;fontColor=#1A1A1A;align=center;verticalAlign=middle;spacing=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="758" y="346" width="28" height="28" as="geometry"/></mxCell>
        <mxCell id="s11" value="&lt;b style=&quot;font-size:10px&quot;&gt;INTERVIEWER + CANDIDATE&lt;/b&gt;&lt;br&gt;HR and candidate join the video call (LiveKit); identity check of the face (F7)" style="rounded=1;arcSize=12;fillColor=#6C4FB0;strokeColor=none;html=1;whiteSpace=wrap;fontSize=12;fontColor=#FFFFFF;align=center;verticalAlign=middle;spacing=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="770" y="484" width="300" height="92" as="geometry"/></mxCell>
        <mxCell id="b11" value="&lt;b style=&quot;font-size:12px&quot;&gt;11&lt;/b&gt;" style="shape=ellipse;perimeter=ellipsePerimeter;fillColor=#FFFFFF;strokeColor=#6C4FB0;strokeWidth=2;html=1;whiteSpace=wrap;fontSize=12;fontColor=#1A1A1A;align=center;verticalAlign=middle;spacing=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="758" y="472" width="28" height="28" as="geometry"/></mxCell>
        <mxCell id="s12" value="&lt;b style=&quot;font-size:10px&quot;&gt;SYSTEM&lt;/b&gt;&lt;br&gt;Live transcript (Deepgram) and AI Helper, seen by the interviewer only" style="rounded=1;arcSize=12;fillColor=#F5A623;strokeColor=none;html=1;whiteSpace=wrap;fontSize=12;fontColor=#1A1A1A;align=center;verticalAlign=middle;spacing=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="770" y="610" width="300" height="92" as="geometry"/></mxCell>
        <mxCell id="b12" value="&lt;b style=&quot;font-size:12px&quot;&gt;12&lt;/b&gt;" style="shape=ellipse;perimeter=ellipsePerimeter;fillColor=#FFFFFF;strokeColor=#F5A623;strokeWidth=2;html=1;whiteSpace=wrap;fontSize=12;fontColor=#1A1A1A;align=center;verticalAlign=middle;spacing=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="758" y="598" width="28" height="28" as="geometry"/></mxCell>
        <mxCell id="lane3" value="" style="rounded=1;arcSize=2;fillColor=#F1EFF9;strokeColor=none;html=1;whiteSpace=wrap;fontSize=12;fontColor=#1f2937;align=center;verticalAlign=middle;spacing=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1128" y="110" width="324" height="620" as="geometry"/></mxCell>
        <mxCell id="ph3" value="&lt;b style=&quot;font-size:16px&quot;&gt;4. Assess and decide&lt;/b&gt;" style="text;strokeColor=none;fillColor=none;html=1;whiteSpace=wrap;fontSize=12;fontColor=#1A1A1A;align=center;verticalAlign=middle;spacing=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1140" y="120" width="300" height="36" as="geometry"/></mxCell>
        <mxCell id="s16" value="&lt;b style=&quot;font-size:10px&quot;&gt;INTERVIEWER / HR&lt;/b&gt;&lt;br&gt;Good candidates go to the Talent Pool for later jobs (F11)" style="rounded=1;arcSize=12;fillColor=#148F77;strokeColor=none;html=1;whiteSpace=wrap;fontSize=12;fontColor=#FFFFFF;align=center;verticalAlign=middle;spacing=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1140" y="232" width="300" height="92" as="geometry"/></mxCell>
        <mxCell id="b16" value="&lt;b style=&quot;font-size:12px&quot;&gt;16&lt;/b&gt;" style="shape=ellipse;perimeter=ellipsePerimeter;fillColor=#FFFFFF;strokeColor=#148F77;strokeWidth=2;html=1;whiteSpace=wrap;fontSize=12;fontColor=#1A1A1A;align=center;verticalAlign=middle;spacing=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1128" y="220" width="28" height="28" as="geometry"/></mxCell>
        <mxCell id="s15" value="&lt;b style=&quot;font-size:10px&quot;&gt;INTERVIEWER / HR&lt;/b&gt;&lt;br&gt;HR compares the candidates and decides: hire, hold or reject" style="rounded=1;arcSize=12;fillColor=#148F77;strokeColor=none;html=1;whiteSpace=wrap;fontSize=12;fontColor=#FFFFFF;align=center;verticalAlign=middle;spacing=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1140" y="358" width="300" height="92" as="geometry"/></mxCell>
        <mxCell id="b15" value="&lt;b style=&quot;font-size:12px&quot;&gt;15&lt;/b&gt;" style="shape=ellipse;perimeter=ellipsePerimeter;fillColor=#FFFFFF;strokeColor=#148F77;strokeWidth=2;html=1;whiteSpace=wrap;fontSize=12;fontColor=#1A1A1A;align=center;verticalAlign=middle;spacing=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1128" y="346" width="28" height="28" as="geometry"/></mxCell>
        <mxCell id="s14" value="&lt;b style=&quot;font-size:10px&quot;&gt;SYSTEM&lt;/b&gt;&lt;br&gt;Assessment report + CV claim check against the interview (F8)" style="rounded=1;arcSize=12;fillColor=#F5A623;strokeColor=none;html=1;whiteSpace=wrap;fontSize=12;fontColor=#1A1A1A;align=center;verticalAlign=middle;spacing=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1140" y="484" width="300" height="92" as="geometry"/></mxCell>
        <mxCell id="b14" value="&lt;b style=&quot;font-size:12px&quot;&gt;14&lt;/b&gt;" style="shape=ellipse;perimeter=ellipsePerimeter;fillColor=#FFFFFF;strokeColor=#F5A623;strokeWidth=2;html=1;whiteSpace=wrap;fontSize=12;fontColor=#1A1A1A;align=center;verticalAlign=middle;spacing=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1128" y="472" width="28" height="28" as="geometry"/></mxCell>
        <mxCell id="s13" value="&lt;b style=&quot;font-size:10px&quot;&gt;SYSTEM&lt;/b&gt;&lt;br&gt;Six graders score each answer: scorecard (F9); interview quality check (F10)" style="rounded=1;arcSize=12;fillColor=#F5A623;strokeColor=none;html=1;whiteSpace=wrap;fontSize=12;fontColor=#1A1A1A;align=center;verticalAlign=middle;spacing=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1140" y="610" width="300" height="92" as="geometry"/></mxCell>
        <mxCell id="b13" value="&lt;b style=&quot;font-size:12px&quot;&gt;13&lt;/b&gt;" style="shape=ellipse;perimeter=ellipsePerimeter;fillColor=#FFFFFF;strokeColor=#F5A623;strokeWidth=2;html=1;whiteSpace=wrap;fontSize=12;fontColor=#1A1A1A;align=center;verticalAlign=middle;spacing=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1128" y="598" width="28" height="28" as="geometry"/></mxCell>
        <mxCell id="start" value="&lt;b style=&quot;font-size:16px&quot;&gt;Start&lt;/b&gt;" style="rounded=1;arcSize=50;fillColor=#2F2F2F;strokeColor=none;html=1;whiteSpace=wrap;fontSize=12;fontColor=#FFFFFF;align=center;verticalAlign=middle;spacing=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="120.0" y="172" width="120" height="44" as="geometry"/></mxCell>
        <mxCell id="end" value="&lt;b style=&quot;font-size:16px&quot;&gt;End&lt;/b&gt;" style="rounded=1;arcSize=50;fillColor=#2F2F2F;strokeColor=none;html=1;whiteSpace=wrap;fontSize=12;fontColor=#FFFFFF;align=center;verticalAlign=middle;spacing=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1230.0" y="172" width="120" height="44" as="geometry"/></mxCell>
        <mxCell id="legend" value="" style="rounded=1;arcSize=2;fillColor=#ffffff;strokeColor=#cbd5e1;strokeWidth=1.3;html=1;whiteSpace=wrap;fontSize=12;fontColor=#1f2937;align=center;verticalAlign=middle;spacing=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="30" y="754" width="560" height="96" as="geometry"/></mxCell>
        <mxCell id="lgt" value="&lt;b style=&quot;font-size:13px&quot;&gt;Who does each step&lt;/b&gt;" style="text;strokeColor=none;fillColor=none;html=1;whiteSpace=wrap;fontSize=12;fontColor=#1f2937;align=left;verticalAlign=middle;spacing=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="760" width="200" height="22" as="geometry"/></mxCell>
