        <mxCell id="cvb_title" value="&lt;b style=&quot;font-size:15px&quot;&gt;CV screening (2 of 2)&lt;/b&gt;" style="text;strokeColor=none;fillColor=none;html=1;whiteSpace=wrap;fontSize=12;fontColor=#1f2937;align=left;verticalAlign=middle;spacing=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="42" y="380" width="270" height="22" as="geometry"/></mxCell>
        <mxCell id="cvb_desc" value="Score, save and wait for the person. One AI call scores skills, experience and qualifications with quotes; code checks the quotes, counts ATS keywords and the weighted score. PAUSE: hr_review waits for include / exclude, and the decision can be changed later. An include / exclude click on a finished run starts it at hr_review." style="text;strokeColor=none;fillColor=none;html=1;whiteSpace=wrap;fontSize=11.5;fontColor=#374151;align=left;verticalAlign=top;spacing=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="42" y="404" width="270" height="171" as="geometry"/></mxCell>
