        <mxCell id="cva_desc" value="Read the CV and apply the rule. One run per CV. Code reads the file; a weak PDF is read once by the AI. One AI call builds the profile (asked again once). A fixed Python rule decides passed, excluded or needs review." style="text;strokeColor=none;fillColor=none;html=1;whiteSpace=wrap;fontSize=11.5;fontColor=#374151;align=left;verticalAlign=top;spacing=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="42" y="130" width="270" height="204" as="geometry"/></mxCell>
