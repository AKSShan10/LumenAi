        <mxCell id="s" value="Before the interview: every CV is screened, the interviewer decides, and shortlisted candidates get an invitation. Both workflows pause for a person." style="text;strokeColor=none;fillColor=none;html=1;whiteSpace=wrap;fontSize=13;fontColor=#4b5563;align=left;verticalAlign=middle;spacing=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="30" y="48" width="1984" height="36" as="geometry"/></mxCell>
