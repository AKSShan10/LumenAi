        <mxCell id="t" value="&lt;b style=&quot;font-size:22px&quot;&gt;LangGraph 1 · Chatbot and job&lt;/b&gt;" style="text;strokeColor=none;fillColor=none;html=1;whiteSpace=wrap;fontSize=12;fontColor=#1f2937;align=left;verticalAlign=middle;spacing=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="30" y="14" width="1348" height="30" as="geometry"/></mxCell>
        <mxCell id="s" value="The chatbot (ReAct agent) and the two job workflows it starts. The AI can only ask; a person approves and posts." style="text;strokeColor=none;fillColor=none;html=1;whiteSpace=wrap;fontSize=13;fontColor=#4b5563;align=left;verticalAlign=middle;spacing=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="30" y="48" width="1348" height="36" as="geometry"/></mxCell>
        <mxCell id="agent_lane" value="" style="rounded=1;arcSize=2;fillColor=#f8fafc;strokeColor=#cbd5e1;strokeWidth=1.3;html=1;whiteSpace=wrap;fontSize=12;fontColor=#1f2937;align=center;verticalAlign=middle;spacing=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="30" y="96" width="1348" height="266" as="geometry"/></mxCell>
        <mxCell id="agent_title" value="&lt;b style=&quot;font-size:15px&quot;&gt;Assistant agent (chatbot)&lt;/b&gt;" style="text;strokeColor=none;fillColor=none;html=1;whiteSpace=wrap;fontSize=12;fontColor=#1f2937;align=left;verticalAlign=middle;spacing=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="42" y="106" width="270" height="22" as="geometry"/></mxCell>
        <mxCell id="agent_desc" value="ReAct agent (create_react_agent). The AI picks a tool, reads the result and picks again until it can answer. pre_model_hook shows it the last 30 messages; at most 16 steps; chat memory in PostgreSQL (one thread per chat). Tools: Knowledge base search and add, write_job_draft, save_job, list/get jobs, prepare_job_post (recruitment-mcp), check_blogger_settings. Ask-only: request_job_approval, request_job_post. publish_blog_post is hidden from the AI." style="text;strokeColor=none;fillColor=none;html=1;whiteSpace=wrap;fontSize=11.5;fontColor=#374151;align=left;verticalAlign=top;spacing=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="42" y="130" width="270" height="222" as="geometry"/></mxCell>
        <mxCell id="agent_pre_model_hook" value="pre_model_hook (last 30 messages)" style="rounded=1;arcSize=12;fillColor=#dcfce7;strokeColor=#16a34a;strokeWidth=1.3;html=1;whiteSpace=wrap;fontSize=11;fontColor=#1f2937;align=center;verticalAlign=middle;spacing=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="350" y="209.0" width="150" height="40" as="geometry"/></mxCell>
        <mxCell id="agent_agent" value="agent (Gemini)" style="rounded=1;arcSize=12;fillColor=#ede9fe;strokeColor=#7c3aed;strokeWidth=1.3;html=1;whiteSpace=wrap;fontSize=11;fontColor=#1f2937;align=center;verticalAlign=middle;spacing=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="562" y="209.0" width="150" height="40" as="geometry"/></mxCell>
        <mxCell id="agent_tools" value="tools (MCP + ask-only tools)" style="rounded=1;arcSize=12;fillColor=#ffedd5;strokeColor=#ea580c;strokeWidth=1.3;html=1;whiteSpace=wrap;fontSize=11;fontColor=#1f2937;align=center;verticalAlign=middle;spacing=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="774" y="183.0" width="150" height="40" as="geometry"/></mxCell>
        <mxCell id="agent_end" value="end (answer)" style="rounded=1;arcSize=50;fillColor=#f1f5f9;strokeColor=#64748b;strokeWidth=1.3;html=1;whiteSpace=wrap;fontSize=11;fontColor=#1f2937;align=center;verticalAlign=middle;spacing=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="774" y="235.0" width="150" height="40" as="geometry"/></mxCell>
        <mxCell id="jd_lane" value="" style="rounded=1;arcSize=2;fillColor=#f8fafc;strokeColor=#cbd5e1;strokeWidth=1.3;html=1;whiteSpace=wrap;fontSize=12;fontColor=#1f2937;align=center;verticalAlign=middle;spacing=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="30" y="388" width="1348" height="196" as="geometry"/></mxCell>
        <mxCell id="jd_title" value="&lt;b style=&quot;font-size:15px&quot;&gt;Job description&lt;/b&gt;" style="text;strokeColor=none;fillColor=none;html=1;whiteSpace=wrap;fontSize=12;fontColor=#1f2937;align=left;verticalAlign=middle;spacing=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="42" y="398" width="270" height="22" as="geometry"/></mxCell>
        <mxCell id="jd_desc" value="Started by the chatbot&amp;#x27;s write_job_draft tool. RAG: 2 similar past jobs + 3 company policies. Code checks the draft and the AI revises it at most once. A rewrite in the chat is a new run with the change and the previous draft." style="text;strokeColor=none;fillColor=none;html=1;whiteSpace=wrap;fontSize=11.5;fontColor=#374151;align=left;verticalAlign=top;spacing=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="42" y="422" width="270" height="152" as="geometry"/></mxCell>
