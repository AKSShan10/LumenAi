# Copy this file to .env and fill in your own values. Never commit .env.
APP_NAME=LumenAI

# ---- Database: PostgreSQL ----
POSTGRES_USER=recruit
POSTGRES_PASSWORD=change-me
POSTGRES_DB=recruit
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# ---- AI: Google Gemini ----
# Get a key at https://aistudio.google.com/apikey
# Set LLM_PROVIDER=fake to try the app offline (simple rules, NOT real AI).
LLM_PROVIDER=gemini
LLM_API_KEY=replace-me
LLM_MODEL=gemini-3.5-flash

# ---- Login ----
# The interviewer's email and password are NOT set here: the app asks you to create the account the first time
# you open it, and saves it in the database. SECRET_KEY is a long random text that signs the login tokens.
SECRET_KEY=replace-with-a-long-random-string

# ---- Ports on your computer (Docker) ----
# Change a number if Docker says "port is already allocated".
API_PORT=8010          # backend API
WEB_PORT=8090          # web app
DB_HOST_PORT=5433      # PostgreSQL inside Docker, as seen from your computer

# CVs: applications are read from the Google Form's response sheet, and the CV files are saved on this computer.
DRIVE_PROVIDER=google             # google = read Google Drive; fake = read backend/tests/fake_drive (made-up CVs)
GOOGLE_DRIVE_KEY_FILE=secrets/google-drive.json   # service-account key file; never committed
STORAGE_DIR=storage               # where CV files are saved, inside backend/ (never committed)

# CV screening: new CVs are screened by the backend by itself.
SCREENING_MODE=background         # background = screen new CVs by itself; manual = only when asked (tests)
SCREENING_RATE_LIMIT_WAIT=60      # seconds to wait when the free Gemini key says "too many requests"

# Job posts on Blogger. Put your real values only in .env, never here.
BLOGGER_PROVIDER=blogger          # blogger = really publish; fake = publish nothing (tests, demos)
BLOGGER_BLOG_ID=                  # the number in the blog's address on blogger.com
BLOGGER_CLIENT_ID=                # OAuth client from Google Cloud Console
BLOGGER_CLIENT_SECRET=            # from the same OAuth client
BLOGGER_REFRESH_TOKEN=            # made once by: python scripts/blogger_login.py

# Log file with every API call, AI call and job post. Empty = terminal only.
LOG_FILE=logs/lumenai.log

# ---- Interview invitation email (with a calendar invite) ----
# The start of the candidate's join link. Docker: http://localhost:8090 (WEB_PORT); npm run dev: http://localhost:5173
# With the HTTPS tunnel (docker compose --profile tunnel up): the https://....trycloudflare.com address from its log
APP_URL=http://localhost:8090
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, your address, and an app password (Google account > Security > App passwords).
# SMTP_HOST empty = the invitation is saved as "not sent" and can be copied by hand.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# SMTP_STARTTLS=false
# mcp = through the email MCP server (default) | smtp = the backend sends directly
EMAIL_TRANSPORT=mcp

# ---- Video call (LiveKit) ----
# LIVEKIT_URL=/  = the LiveKit server in Docker (the livekit service), reached through the app's own address.
#                  Works on this computer, and for a phone on the same Wi-Fi when LIVEKIT_NODE_IP is set.
# LIVEKIT_URL=wss://your-project.livekit.cloud = LiveKit Cloud (free plan: https://cloud.livekit.io > Settings > Keys).
#                  Needed when the candidate is on another network (the video needs UDP, which a tunnel cannot carry).
# The key and secret sign the call tickets. For Docker any values work (the secret needs 32+ characters);
# for LiveKit Cloud use the project's key and secret.
LIVEKIT_URL=/
LIVEKIT_API_KEY=lumenai-dev
LIVEKIT_API_SECRET=replace-with-a-long-random-string-of-32-or-more-characters
# The address the browsers send the video to (Docker LiveKit only): 127.0.0.1 = this computer;
# this computer's Wi-Fi address (e.g. 192.168.0.5) = also phones on the same Wi-Fi.
LIVEKIT_NODE_IP=127.0.0.1
LIVEKIT_PORT=7880      # LiveKit signalling on your computer (only used by "npm run dev")

# ---- Live transcript (speech-to-text) ----
# deepgram = Deepgram live (key: https://console.deepgram.com > API Keys) | fake = test sentences, no key (demos)
STT_PROVIDER=deepgram
DEEPGRAM_API_KEY=
# DEEPGRAM_MODEL=nova-3
# DEEPGRAM_LANGUAGE=en

# ---- MCP servers ----
# Docker runs each MCP server as its own service and sets their addresses itself (docker-compose.yml).
# Without Docker, leave these empty: the backend starts the servers as child processes.
MCP_EMAIL_URL=
MCP_BLOGGER_URL=
MCP_RECRUITMENT_URL=
