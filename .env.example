# Copy this file to .env and fill in your own values. Never commit .env.
APP_NAME=LumenAI

# ---- Database: PostgreSQL ----
POSTGRES_USER=recruit
POSTGRES_PASSWORD=change-me
POSTGRES_DB=recruit
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# ---- AI: Google Gemini ----
# Get a key at https://aistudio.google.com/apikey
# Set LLM_PROVIDER=fake to try the app offline (simple rules, NOT real AI).
LLM_PROVIDER=gemini
LLM_API_KEY=replace-me
LLM_MODEL=gemini-3.5-flash

# ---- Login ----
# One shared passcode for the interviewer, and a long random text that signs the login tokens.
INTERVIEWER_PASSCODE=change-me
SECRET_KEY=replace-with-a-long-random-string

# ---- Ports on your computer (Docker) ----
# Change a number if Docker says "port is already allocated".
API_PORT=8010          # backend API
WEB_PORT=8090          # web app
DB_HOST_PORT=5433      # PostgreSQL inside Docker, as seen from your computer

# Job posts on Telegram. Put your real values only in .env, never here.
TELEGRAM_PROVIDER=telegram        # telegram = really post; fake = post nothing (tests, demos)
TELEGRAM_BOT_TOKEN=               # from @BotFather
TELEGRAM_CHANNEL_ID=              # @channelname, or a number like -1001234567890

# Log file with every API call, AI call and Telegram post. Empty = terminal only.
LOG_FILE=logs/lumenai.log
